{
  "meta": {
    "project_title": "Elegibilidad TG",
    "version": "1.0.0",
    "author_group": "grupo_05"
  },
  "attributes": [
    {
      "id": "materia",
      "name": "Materia",
      "type": "categorical",
      "options": ["Trabajo de Graduacion", "Otra"]
    },
    {
      "id": "promedio",
      "name": "Promedio",
      "type": "numeric",
      "range": [0, 3]
    },
    {
      "id": "creditos",
      "name": "Creditos",
      "type": "numeric"
    },
    {
      "id": "dictamen",
      "name": "Dictamen",
      "type": "categorical",
      "options": ["Elegible", "No elegible"]
    },
    {
      "id": "nivel",
      "name": "Nivel",
      "type": "categorical",
      "options": ["basico", "avanzado"]
    }
  ],
  "rules": [
    {
      "id": "rule_01",
      "description": "Elegibilidad para un tramite",
      "priority": 10,
      "conditions": [
        {
          "attribute_id": "materia",
          "operator": "==",
          "value": "Trabajo de Graduacion"
        },
        {
          "attribute_id": "promedio",
          "operator": ">=",
          "value": 2.0
        }
      ],
      "conclusion": {
        "attribute_id": "dictamen",
        "value": "Elegible"
      },
      "explanation_template": "El promedio cumple el minimo requerido."
    },
    {
      "id": "rule_02",
      "description": "No elegible por promedio bajo",
      "priority": 5,
      "conditions": [
        {
          "attribute_id": "promedio",
          "operator": "<",
          "value": 2.0
        }
      ],
      "conclusion": {
        "attribute_id": "dictamen",
        "value": "No elegible"
      },
      "explanation_template": "El promedio es insuficiente."
    },
    {
      "id": "rule_03",
      "description": "Nivel avanzado por creditos",
      "priority": 20,
      "conditions": [
        {
          "attribute_id": "creditos",
          "operator": ">=",
          "value": 120
        },
        {
          "attribute_id": "dictamen",
          "operator": "==",
          "value": "Elegible"
        }
      ],
      "conclusion": {
        "attribute_id": "nivel",
        "value": "avanzado"
      },
      "explanation_template": "Creditos suficientes para nivel avanzado."
    },
    {
      "id": "rule_04",
      "description": "Materia permitida via in",
      "priority": 1,
      "conditions": [
        {
          "attribute_id": "materia",
          "operator": "in",
          "value": ["Trabajo de Graduacion", "Seminario"]
        }
      ],
      "conclusion": {
        "attribute_id": "materia_valida",
        "value": true
      },
      "explanation_template": "La materia esta en el catalogo permitido."
    }
  ]
}
